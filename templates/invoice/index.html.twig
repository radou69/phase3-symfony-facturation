{% extends 'base.html.twig' %}

{% block title %}Factures - FacturSaaS{% endblock %}

{% block body %}

<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Factures</h1>
    <a href="{{ path('app_invoice_new') }}" class="bg-blue-600 text-white px-4 py-2 rounded-lg flex items-center gap-2 hover:bg-blue-700">
        + Créer une facture
    </a>
</div>

<div class="bg-white rounded-xl border border-gray-200">
    <table class="w-full">
        <thead>
            <tr class="border-b border-gray-200">
                <th class="text-left px-6 py-3 text-sm text-gray-500 font-semibold">Numéro</th>
                <th class="text-left px-6 py-3 text-sm text-gray-500 font-semibold">Client</th>
                <th class="text-left px-6 py-3 text-sm text-gray-500 font-semibold">Montant</th>
                <th class="text-left px-6 py-3 text-sm text-gray-500 font-semibold">Statut</th>
                <th class="text-left px-6 py-3 text-sm text-gray-500 font-semibold">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for invoice in invoices %}
            <tr class="border-b border-gray-100 hover:bg-gray-50">
                <td class="px-6 py-4 font-medium">{{ invoice.number }}</td>
                <td class="px-6 py-4">{{ invoice.client.name }}</td>
                <td class="px-6 py-4">{{ invoice.total }} €</td>
                <td class="px-6 py-4">
                    {% if invoice.status == 'draft' %}
                        <span class="bg-gray-100 text-gray-600 px-3 py-1 rounded-full text-sm">Brouillon</span>
                    {% elseif invoice.status == 'pending' %}
                        <span class="bg-yellow-100 text-yellow-600 px-3 py-1 rounded-full text-sm">En attente</span>
                    {% elseif invoice.status == 'paid' %}
                        <span class="bg-green-100 text-green-600 px-3 py-1 rounded-full text-sm">Payée</span>
                    {% endif %}
                </td>
                <td class="px-6 py-4 flex gap-3">
                    <a href="{{ path('app_invoice_show', {'id': invoice.id}) }}" class="text-blue-600 hover:text-blue-800">👁️</a>
                    <a href="{{ path('app_invoice_edit', {'id': invoice.id}) }}" class="text-blue-600 hover:text-blue-800">✏️</a>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="5" class="px-6 py-8 text-center text-gray-400">Aucune facture pour l'instant.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}