{% extends 'base.html.twig' %}

{% block title %}Clients - FacturSaaS{% endblock %}

{% block body %}

<div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Clients</h1>
    <a href="{{ path('app_client_new') }}" class="bg-blue-600 text-white px-4 py-2 rounded-lg flex items-center gap-2 hover:bg-blue-700">
        + Ajouter un client
    </a>
</div>

<div class="bg-white rounded-xl border border-gray-200">
    <table class="w-full">
        <thead>
            <tr class="border-b border-gray-200">
                <th class="text-left px-6 py-3 text-sm text-gray-500 font-semibold">Nom</th>
                <th class="text-left px-6 py-3 text-sm text-gray-500 font-semibold">Contact</th>
                <th class="text-left px-6 py-3 text-sm text-gray-500 font-semibold">Adresse</th>
                <th class="text-left px-6 py-3 text-sm text-gray-500 font-semibold">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for client in clients %}
            <tr class="border-b border-gray-100 hover:bg-gray-50">
                <td class="px-6 py-4 font-medium">{{ client.name }}</td>
                <td class="px-6 py-4">
                    <div>{{ client.email }}</div>
                    <div class="text-sm text-gray-400">{{ client.phone }}</div>
                </td>
                <td class="px-6 py-4 text-gray-500">{{ client.address }}</td>
                <td class="px-6 py-4 flex gap-3">
                    <a href="{{ path('app_client_edit', {'id': client.id}) }}" class="text-blue-600 hover:text-blue-800">✏️</a>
                    <form method="post" action="{{ path('app_client_delete', {'id': client.id}) }}" onsubmit="return confirm('Supprimer ce client ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ client.id) }}">
                        <button type="submit" class="text-red-500 hover:text-red-700">🗑️</button>
                    </form>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="4" class="px-6 py-8 text-center text-gray-400">Aucun client pour l'instant.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}