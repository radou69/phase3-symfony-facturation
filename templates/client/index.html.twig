{% extends 'base.html.twig' %}

{% block title %}Mes clients{% endblock %}

{% block body %}
<style>
    .client-page { margin: 2rem auto; max-width: 1100px; width: 95%; font: 16px/1.5 sans-serif; }
    .client-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
    .client-header h1 { margin: 0; }
    .client-action { color: #fff; background: #2563eb; border-radius: 6px; padding: .6rem .9rem; text-decoration: none; }
    .client-table { border-collapse: collapse; width: 100%; }
    .client-table th, .client-table td { border-bottom: 1px solid #ddd; padding: .75rem; text-align: left; vertical-align: top; }
    .client-table th { background: #f5f5f5; font-weight: 700; }
    .empty-state { background: #f5f5f5; border-radius: 6px; padding: 1rem; }
</style>

<main class="client-page">
    <div class="client-header">
        <h1>Mes clients</h1>
        <a class="client-action" href="{{ path('app_client_new') }}">Nouveau client</a>
    </div>

    {% if clients is empty %}
        <p class="empty-state">Aucun client pour l'instant.</p>
    {% else %}
        <table class="client-table">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Email</th>
                    <th>Téléphone</th>
                    <th>Adresse</th>
                    <th>SIRET</th>
                    <th>RIB</th>
                </tr>
            </thead>
            <tbody>
                {% for client in clients %}
                    <tr>
                        <td>{{ client.name }}</td>
                        <td>{{ client.email }}</td>
                        <td>{{ client.phone }}</td>
                        <td>{{ client.address }}</td>
                        <td>{{ client.siret ?? '-' }}</td>
                        <td>{{ client.rib }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</main>
{% endblock %}
