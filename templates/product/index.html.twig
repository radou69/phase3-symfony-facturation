{% extends 'base.html.twig' %}

{% block title %}Mes produits{% endblock %}

{% block body %}
<div>
    <h1>Mes produits</h1>
    <a href="{{ path('app_product_new') }}">+ Nouveau produit</a>

    {% for message in app.flashes('success') %}
        <div style="color: green;">{{ message }}</div>
    {% endfor %}

    {% if products is empty %}
        <p>Aucun produit pour l'instant.</p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Description</th>
                    <th>Prix</th>
                    <th>Unité</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for product in products %}
                <tr>
                    <td>{{ product.name }}</td>
                    <td>{{ product.description }}</td>
                    <td>{{ product.price }} €</td>
                    <td>{{ product.unit }}</td>
                    <td>
                        <a href="{{ path('app_product_edit', {id: product.id}) }}">Modifier</a>
                        <form method="post" action="{{ path('app_product_delete', {id: product.id}) }}" style="display:inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_product_' ~ product.id) }}">
                            <button type="submit" onclick="return confirm('Supprimer ce produit ?')">Supprimer</button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>
{% endblock %}