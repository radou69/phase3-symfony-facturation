{% extends 'base.html.twig' %}

{% block title %}Modifier {{ client.name }}{% endblock %}

{% block body %}
<div>
    <h1>Modifier {{ client.name }}</h1>
    <a href="{{ path('app_client_index') }}">← Retour à la liste</a>

    {{ form_start(form) }}
        {{ form_row(form.name) }}
        {{ form_row(form.email) }}
        {{ form_row(form.phone) }}
        {{ form_row(form.address) }}
        {{ form_row(form.siret) }}
        {{ form_row(form.rib) }}
        <button type="submit">Enregistrer</button>
    {{ form_end(form) }}
</div>
{% endblock %}