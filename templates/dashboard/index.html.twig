{% extends 'base.html.twig' %}

{% block title %}Mes clients{% endblock %}

{% block body %}
<div>
    <h1>Mes clients</h1>
    <a href="{{ path('app_client_new') }}">+ Nouveau client</a>

    {% for message in app.flashes('success') %}
        <div style="color: green;">{{ message }}</div>
    {% endfor %}

    {% if clients is empty %}
        <p>Aucun client pour l'instant.</p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Email</th>
                    <th>Téléphone</th>
                    <th>Adresse</th>
                    <th>SIRET</th>
                    <th>RIB</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for client in clients %}
                <tr>
                    <td>{{ client.name }}</td>
                    <td>{{ client.email }}</td>
                    <td>{{ client.phone }}</td>
                    <td>{{ client.address }}</td>
                    <td>{{ client.siret ?? '-' }}</td>
                    <td>{{ client.rib }}</td>
                    <td>
                        <a href="{{ path('app_client_edit', {id: client.id}) }}">Modifier</a>
                        <form method="post" action="{{ path('app_client_delete', {id: client.id}) }}" style="display:inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_client_' ~ client.id) }}">
                            <button type="submit" onclick="return confirm('Supprimer ce client ?')">Supprimer</button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>
{% endblock %}